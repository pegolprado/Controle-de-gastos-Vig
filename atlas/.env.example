# Copie para .env e preencha. NUNCA versione o .env.
DOMAIN=iamarx.com.br
ACME_EMAIL=seu-email@exemplo.com.br
# Gere com:  openssl rand -base64 48
SECRET_KEY=troque-por-uma-chave-aleatoria-longa
POSTGRES_PASSWORD=troque-por-uma-senha-forte
ATLAS_ORG_NAME=Minha Instituição
# Sessão: duração máxima e expiração por inatividade (minutos)
SESSION_MINUTES=480
IDLE_MINUTES=60
MAX_UPLOAD_MB=300
WEB_WORKERS=2
# E-mail para recuperação de senha (opcional; sem ele o admin gera links)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Mapa: o servidor público do OpenStreetMap tem política de uso restrita.
# Para uso contínuo, configure um provedor de tiles contratado e ajuste EXTRA_IMG_SRC.
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_ATTRIBUTION=&copy; colaboradores do OpenStreetMap
EXTRA_IMG_SRC=
