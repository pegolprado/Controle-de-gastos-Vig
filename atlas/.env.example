# Copie para .env e preencha. NUNCA versione o .env.
# Produção: iamarx.com.br · Teste no seu computador: localhost
DOMAIN=iamarx.com.br
# Gere com:  openssl rand -base64 48
SECRET_KEY=troque-por-uma-chave-aleatoria-longa
# Sessão: duração máxima e encerramento por inatividade (minutos).
# Ao encerrar, a análise aberta no navegador é apagada da memória.
SESSION_MINUTES=480
IDLE_MINUTES=30
# Bloqueio após tentativas de login erradas
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
# E-mail para recuperação de senha (opcional; sem ele o admin gera links)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Mapa: as imagens de fundo vêm do provedor de tiles (o navegador pede a região exibida).
# Deixe MAP_TILE_URL vazio para não usar mapa de fundo externo.
# O servidor público do OpenStreetMap tem política de uso restrita; para uso contínuo,
# contrate um provedor e ajuste EXTRA_IMG_SRC (domínio das imagens).
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_ATTRIBUTION=&copy; colaboradores do OpenStreetMap
EXTRA_IMG_SRC=
