# Copie para .env.local (desenvolvimento) e configure no provedor de hospedagem.
# Somente chaves PÚBLICAS aqui — a anon key é segura no navegador porque o
# acesso aos dados é controlado por RLS. NUNCA coloque a service_role key.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-anon-key-publica
# Ambiente exibido no app: development | staging | production
VITE_APP_ENV=development
